TRUNCATE TABLE RSRpt.GIV3.PlineInsuredDetail;

-- Get Past 3 years policy data
Select p.PolicyNo
	, p.ProductCode
	, p.ProductName
	, p.PolicyEffectiveDate
	, p.PolicyExpiryDate
	, p.PolicyStatusDesc
	, p.TerminateCodeDesc
	, p.PremiumWithoutGST
	, p.IssueDate
	, p.policyId	

INTO #TempPol

FROM GIV3.bv_policy p
where p.ProductCateType = 'PLine'
and DATEDIFF(mm, p.issuedate, GETDATE()) <= 36

CREATE INDEX IX_TempPol_PolId ON #TempPol(policyid)


-- Get customer data
Select Nric
	, indi.name
	, indi.DateOfBirth
	, indi.Gender
	, indi.MaritalStatus
	, Indi.NationalityDesc
	, indi.RaceDesc
	, indi.Address1
	, indi.Address2
	, indi.Address3
	, indi.Address4
	, indi.PostalCode
	, indi.Address
	, indi.HomeTel
	, indi.Mobile
	, indi.OfficeTel
	, indi.Email
	, indi.EmailFlag

INTO #TempIndiv
FROM GIV3.bv_indivcustomer indi
WHERE NRIC IS NOT NULL

CREATE INDEX IX_TempIndiv_Nric ON #TempIndiv(Nric)


-- Use function to get insured level details
Select p.PolicyNo [Policy No]
	, p.ProductCode [Product Code]
	, p.ProductName [Product Name]
	, p.PolicyEffectiveDate [Policy Effective Date]
	, p.PolicyExpiryDate [Policy Expiry Date]
	, p.PolicyStatusDesc [Policy Status]
	, p.TerminateCodeDesc [Terminate Status]
	, p.PremiumWithoutGST [Premium Without GST]
	, p.IssueDate [Issue Date]	
	, ins.NoOfChild [No Of Child]
	, ins.NoOfAdult [No Of Adult]
	, ins.FamilyType [Family Type]
	, ins.TravellerType [Traveller Type]
	, ins.NoOfChildrenTravelinFamily [No Of Children Travel in Family]
	, ins.PlanType [Plan Type]
	, ins.CoverType [Cover Type]
	, ins.NoOfChildPolLevel [No Of Child at Policy Level]
	, ins.NoOfAdultPolLevel [No of Adult at Policy Level]
	, ins.NoOfInsuredPolLevel [No of Insured at Policy Level]
	, ins.NoOfCoverTypePolLevel [No Of Cover Type at Policy Level]
	
	, CASE WHEN p.ProductCode = 'GDB' THEN CASE WHEN ins.TransmissionFlag=0 THEN 'N - Not Transmitted' WHEN ins.TransmissionFlag = 1 THEN 'T – Transmitted' END ELSE NULL END  [Transmission Flag]
	, CASE WHEN p.ProductCode = 'GDB' THEN CASE WHEN ins.WithWaiver=0 THEN 'NO' WHEN ins.WithWaiver=1 THEN 'YES' END ELSE NULL END [With Waiver]
	, CASE WHEN p.ProductCode = 'GDB' THEN DATEADD(SECOND, CAST(ins.FollowupDate AS BIGINT)/1000, '1970-1-1') ELSE NULL END [FollowUp Date]
	, ins.Memo	
	, CASE WHEN p.productCode = 'GPB' THEN CASE WHEN ins.InfectiousDiseaseCoverage=0 THEN 'NO' WHEN ins.InfectiousDiseaseCoverage=1 THEN 'YES' END ELSE NULL END [Infectious Disease Coverage]	
	, ins.InsuredNRIC [Insured NRIC]
	, ISNULL(indi.name, ins.InsuredName) [Insured Name]
	, ins.OccupationClass [Occupation Class]
	, ins.Occupation [Occupation]
	, ins.OtherOccupation [Other Occupation]
	, ins.InsuredDOB [Insured DOB]   --revised to insured level
	, ins.Gender [Insured Gender]	--revised to insured level
	, indi.MaritalStatus [Insured Marital Status]
	, ins.InsuredNationality [Insured Nationality]   --revised to insured level
	, indi.RaceDesc [Insured Race]
	, ins.InsuredAddress1 [Insured Address 1] --revised to insured level
	, ins.InsuredAddress2 [Insured Address 2] --revised to insured level
	, ins.InsuredAddress3 [Insured Address 3] --revised to insured level
	, ins.InsuredAddress4 [Insured Address 4] --revised to insured level
	, ins.InsuredPostalCode [Insured PostalCode] --revised to insured level
	, ins.[Plan Name]
	, ins.[InsuredLevel ANP]
	, ins.RenewalBonus
	, ins.AgeGroup
	, indi.Address [Insured Full Address]
	, indi.HomeTel [Insured HomeTel]
	, ins.InsuredMobileNo [Insured MobileNo] --revised to insured level
	, indi.OfficeTel [Insured OfficeTel]
	, ins.InsuredEmail [Insured Email] --revised to insured level
	, indi.EmailFlag [Insured EmailFlag] 
	, ins.SNP [Standard Net Premium]
	, ins.SGP [Standard Gross Premium]
	, ins.SmokingStatus [Smoking Status]
	, RptInsertTime = GETDATE()
INTO #final
FROM #TempPol p
CROSS APPLY GIV3.fnInsuredInfo(p.PolicyId) ins
LEFT OUTER JOIN #TempIndiv indi ON indi.Nric = ins.InsuredNRIC


