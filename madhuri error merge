				campaign_uuid,
				product_uuid,
				product_id,
				premium_term,
				coverage_duration,
				insured_age,
				stlt,
				premium_type,
				term,
				decision,
				sales_agent_uuid,
				image_scan_date,
				image_review_date,
				submit_system_date,
				proof_date,
				ntu_date,
				auto_end,
				print_date,
				policy_type,
				business_type,
				source,
				customer_uuid,
				policy_type_code,
				business_type_code,
				source_code,
				pay_mode_id,
				source_pay_mode,
				proposal_no,
				premium_mode_id,
				premium_mode_code,
				first_sales_agent_uuid
								,checksum
    							,'HIST' as table_type 
            FROM 
              el_eds_def.DimProposalCoveredItem b 
            where 
              b.business_key in (
                SELECT 
                  business_key 
                FROM 
                  el_eds_def_stg.stgDimProposalCoveredItem a 
                where 
                  a.record_eff_from_date <> b.record_eff_from_date
              ) 
              AND b.active_record_ind = 'Y' 
              and b.source_app_code = 'ISIS'
          )
      ) temp
  ) temp;
					


